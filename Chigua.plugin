#!name=吃瓜网站去广告
#!desc=移除 mrds66、黑料不打烊、51吃瓜网网页端广告。
#!author=Yuheng0101、2Vrks
#!homepage=https://github.com/Yuheng0101/X
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Safari.png

[Script]
# > Rx去广告
http-response ^https?:\/\/www\.mrds66\.com(?!.*\.(css|js|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot|mp[34]|webm|m3u8|ts|json|xml|txt)) script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/Chigua/Chigua_Clean.js, requires-body=true, timeout=10, tag=Rx去广告

# > 黑料不打烊
http-response ^https?:\/\/hl365\.com(?!.*\.(css|js|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot|mp[34]|webm|m3u8|ts|json|xml|txt)) script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/Chigua/Chigua_Clean.js, requires-body=true, timeout=10, tag=黑料不打烊

# > 51吃瓜网
http-response ^https?:\/\/51cg1\.com(?!.*\.(css|js|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot|mp[34]|webm|m3u8|ts|json|xml|txt)) script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/Chigua/Chigua_Clean.js, requires-body=true, timeout=10, tag=51吃瓜网

[Mitm]
hostname = www.mrds66.com, hl365.com, 51cg1.com
